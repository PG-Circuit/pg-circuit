-- destructive: PGC001-PGC005 detection (Community)
CREATE EXTENSION IF NOT EXISTS pg_circuit;
NOTICE:  extension "pg_circuit" already exists, skipping
DROP TABLE IF EXISTS dest_users;
NOTICE:  table "dest_users" does not exist, skipping
CREATE TABLE dest_users (id int primary key, active bool);
INSERT INTO dest_users VALUES (1, true), (2, true), (3, false);
ANALYZE dest_users;
SET pg_circuit.mode = enforce;
-- PGC001 DELETE without WHERE => blocked
DELETE FROM dest_users;
ERROR:  PG Circuit [PGC001] blocked high-risk operation
DETAIL:  Risk: 95/100
Estimated rows: 3
Relation: public.dest_users
Operating mode: enforce
Runtime mode: NORMAL
Pressure: 0/100
Replication lag: 0.0s
Decision: BLOCK
HINT:  retry in smaller batches (add WHERE); then SELECT * FROM pg_circuit_events() and pg_circuit_explain_risk(...); adjust pg_circuit.mode or risk_*_threshold
-- DELETE with WHERE => allowed
DELETE FROM dest_users WHERE id = 1;
SELECT count(*) FROM dest_users;
 count 
-------
     2
(1 row)

-- PGC002 UPDATE without WHERE => blocked
UPDATE dest_users SET active = false;
